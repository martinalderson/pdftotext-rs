+/// When set, [`TextExtractor`](crate::extractors::TextExtractor) runs content
+/// streams through [`parse_and_execute_lean`].
+pub static LEAN_SCAN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+const LC_WS: u8 = 0;
+const LC_NUM: u8 = 1;
+const LC_OP: u8 = 2;
+const LC_NAME: u8 = 3;
+const LC_PAREN: u8 = 4;
+const LC_ANGLE: u8 = 5;
+const LC_BRACKET: u8 = 6;
+const LC_COMMENT: u8 = 7;
+const LC_JUNK: u8 = 8;
+
+/// Token-start classes for [`parse_and_execute_lean`].
+static LEAN_CLASS: [u8; 256] = {
+    let mut t = [LC_JUNK; 256];
+    let mut b = 0usize;
+    while b < 256 {
+        let c = b as u8;
+        t[b] = match c {
+            0 | b'\t' | b'\n' | 0x0c | b'\r' | b' ' => LC_WS,
+            b'0'..=b'9' | b'+' | b'-' | b'.' => LC_NUM,
+            b'a'..=b'z' | b'A'..=b'Z' | b'\'' | b'"' | b'*' => LC_OP,
+            b'/' => LC_NAME,
+            b'(' => LC_PAREN,
+            b'<' => LC_ANGLE,
+            b'[' => LC_BRACKET,
+            b'%' => LC_COMMENT,
+            _ => LC_JUNK,
+        };
+        b += 1;
+    }
+    t
+};
+
+/// One operator with the byte offsets of its operands, kept unparsed until
+/// it is known that the operator has to be executed.
+#[derive(Clone, Copy)]
+struct LeanTok {
+    /// Start offsets of the last (up to 8) operands.
+    starts: [u32; 8],
+    /// Operands seen before the operator, saturating at 255.
+    n: u8,
+    /// Start of the first operand (or of the operator when it has none).
+    first: u32,
+    op_start: u32,
+    op_end: u32,
+}
+
+enum LeanKind {
+    /// Cannot affect text: path construction/painting, clipping, line style,
+    /// colour, shading.
+    Skip,
+    Save,
+    Restore,
+    /// Changes graphics state only; unobservable if the enclosing `q` is
+    /// restored before anything is drawn through it.
+    State,
+    InlineImage,
+    Emit,
+}
+
+#[inline]
+fn lean_kind(op: &[u8]) -> LeanKind {
+    match op {
+        b"q" => LeanKind::Save,
+        b"Q" => LeanKind::Restore,
+        b"cm" | b"gs" => LeanKind::State,
+        b"BI" => LeanKind::InlineImage,
+        b"m" | b"l" | b"c" | b"v" | b"y" | b"h" | b"re" | b"S" | b"s" | b"f" | b"F" | b"f*"
+        | b"B" | b"B*" | b"b" | b"b*" | b"n" | b"W" | b"W*" | b"w" | b"J" | b"j" | b"M"
+        | b"d" | b"i" | b"ri" | b"sh" | b"rg" | b"RG" | b"g" | b"G" | b"k" | b"K" | b"cs"
+        | b"CS" | b"sc" | b"SC" | b"scn" | b"SCN" | b"BX" | b"EX" => LeanKind::Skip,
+        _ => LeanKind::Emit,
+    }
+}
+
+/// Build the operator for `t` straight from the bytes, or `None` when it is
+/// not one of the plain shapes handled here (the caller then falls back to
+/// the general parser for that one operator).
+fn lean_build(data: &[u8], t: &LeanTok) -> Option<Operator> {
+    let op = &data[t.op_start as usize..t.op_end as usize];
+    let n = t.n as usize;
+    if n > 8 {
+        return None;
+    }
+    let num = |k: usize| -> Option<f32> {
+        let s = t.starts[k] as usize;
+        let (v, used) = parse_float_fast(&data[s..])?;
+        // The whole token must be one plain decimal.
+        match data.get(s + used) {
+            Some(&b) if LEAN_CLASS[b as usize] == LC_NUM || b == b'e' || b == b'E' => None,
+            _ => Some(v),
+        }
+    };
+    let string = |k: usize| -> Option<Vec<u8>> {
+        let s = t.starts[k] as usize;
+        match data[s] {
+            b'(' => parse_literal_string_fast(data, s).map(|r| r.0),
+            b'<' if data.get(s + 1) != Some(&b'<') => parse_hex_string_fast(data, s).map(|r| r.0),
+            _ => None,
+        }
+    };
+    let name = |k: usize| -> Option<String> {
+        let s = t.starts[k] as usize;
+        if data[s] != b'/' {
+            return None;
+        }
+        let (name, _) = parse_name_fast(data, s);
+        // `#xx` escapes are left to the general parser.
+        if name.contains('#') {
+            None
+        } else {
+            Some(name)
+        }
+    };
+    Some(match (op, n) {
+        (b"q", _) => Operator::SaveState,
+        (b"BT", 0) => Operator::BeginText,
+        (b"ET", 0) => Operator::EndText,
+        (b"T*", 0) => Operator::TStar,
+        (b"EMC", 0) => Operator::EndMarkedContent,
+        (b"Td", 2) => Operator::Td {
+            tx: num(0)?,
+            ty: num(1)?,
+        },
+        (b"TD", 2) => Operator::TD {
+            tx: num(0)?,
+            ty: num(1)?,
+        },
+        (b"Tm", 6) => Operator::Tm {
+            a: num(0)?,
+            b: num(1)?,
+            c: num(2)?,
+            d: num(3)?,
+            e: num(4)?,
+            f: num(5)?,
+        },
+        (b"cm", 6) => Operator::Cm {
+            a: num(0)?,
+            b: num(1)?,
+            c: num(2)?,
+            d: num(3)?,
+            e: num(4)?,
+            f: num(5)?,
+        },
+        (b"Tj", 1) => Operator::Tj { text: string(0)? },
+        (b"'", 1) => Operator::Quote { text: string(0)? },
+        (b"\"", 3) => Operator::DoubleQuote {
+            word_space: num(0)?,
+            char_space: num(1)?,
+            text: string(2)?,
+        },
+        (b"TJ", 1) if data[t.starts[0] as usize] == b'[' => Operator::TJ {
+            array: parse_tj_array_fast(data, t.starts[0] as usize)?.0,
+        },
+        (b"Tc", 1) => Operator::Tc {
+            char_space: num(0)?,
+        },
+        (b"Tw", 1) => Operator::Tw {
+            word_space: num(0)?,
+        },
+        (b"Tz", 1) => Operator::Tz { scale: num(0)? },
+        (b"TL", 1) => Operator::TL { leading: num(0)? },
+        (b"Ts", 1) => Operator::Ts { rise: num(0)? },
+        (b"Tf", 2) => Operator::Tf {
+            font: name(0)?,
+            size: num(1)?,
+        },
+        (b"Do", 1) => Operator::Do { name: name(0)? },
+        (b"gs", 1) => Operator::SetExtGState {
+            dict_name: name(0)?,
+        },
+        (b"BMC", 1) => Operator::BeginMarkedContent { tag: name(0)? },
+        _ => return None,
+    })
+}
+
+/// Execute a content stream for text extraction in one linear pass.
+///
+/// Operands are only located, never parsed, until their operator turns out to
+/// matter, so the path data that dominates drawings costs a table lookup per
+/// byte. `q … Q` groups that draw nothing but paths are dropped whole,
+/// including any `cm`/`gs` inside them. Colour operators are not delivered:
+/// callers that need span colours must use [`parse_and_execute_text_only`].
+pub fn parse_and_execute_lean<F>(data: &[u8], mut handler: F) -> Result<()>
+where
+    F: FnMut(Operator) -> Result<()>,
+{
+    let len = data.len();
+    if len >= u32::MAX as usize {
+        return parse_and_execute_text_only(data, handler);
+    }
+    let emit = |t: &LeanTok, handler: &mut F| -> Result<()> {
+        if let Some(op) = lean_build(data, t) {
+            return handler(op);
+        }
+        if let Ok((_, op)) = parse_operator_with_operands(&data[t.first as usize..t.op_end as usize])
+        {
+            handler(op)?;
+        }
+        Ok(())
+    };
+
+    let mut i = 0usize;
+    let mut starts = [0u32; 8];
+    let mut n = 0usize;
+    let mut first = 0u32;
+    // Operators held back because an enclosing `q` may yet be restored
+    // without anything having been drawn; `q_marks` indexes the `q`s in it.
+    let mut pending: Vec<LeanTok> = Vec::new();
+    let mut q_marks: Vec<u32> = Vec::new();
+
+    macro_rules! operand {
+        ($at:expr) => {{
+            if n == 0 {
+                first = $at as u32;
+            }
+            if n < 8 {
+                starts[n] = $at as u32;
+            } else {
+                starts.copy_within(1.., 0);
+                starts[7] = $at as u32;
+            }
+            n += 1;
+        }};
+    }
+
+    loop {
+        while i < len && LEAN_CLASS[data[i] as usize] == LC_WS {
+            i += 1;
+        }
+        if i >= len {
+            break;
+        }
+        match LEAN_CLASS[data[i] as usize] {
+            LC_NUM => {
+                operand!(i);
+                i += 1;
+                while i < len && LEAN_CLASS[data[i] as usize] == LC_NUM {
+                    i += 1;
+                }
+            },
+            LC_OP => {
+                let s = i;
+                i += 1;
+                if data[s] != b'\'' && data[s] != b'"' {
+                    while i < len && (data[i].is_ascii_alphanumeric() || data[i] == b'*') {
+                        i += 1;
+                    }
+                }
+                let op = &data[s..i];
+                if matches!(op, b"true" | b"false" | b"null") {
+                    operand!(s);
+                    continue;
+                }
+                let tok = LeanTok {
+                    starts,
+                    n: n.min(255) as u8,
+                    first: if n == 0 { s as u32 } else { first },
+                    op_start: s as u32,
+                    op_end: i as u32,
+                };
+                n = 0;
+                match lean_kind(op) {
+                    LeanKind::Skip => {},
+                    LeanKind::Save => {
+                        q_marks.push(pending.len() as u32);
+                        pending.push(tok);
+                    },
+                    LeanKind::Restore => match q_marks.pop() {
+                        Some(mark) => pending.truncate(mark as usize),
+                        None => handler(Operator::RestoreState)?,
+                    },
+                    LeanKind::State => {
+                        if q_marks.is_empty() {
+                            emit(&tok, &mut handler)?;
+                        } else {
+                            pending.push(tok);
+                        }
+                    },
+                    LeanKind::InlineImage => {
+                        if let Ok((rest, _)) = parse_inline_image(&data[i..]) {
+                            i = len - rest.len();
+                        }
+                    },
+                    LeanKind::Emit => {
+                        if !pending.is_empty() {
+                            for t in &pending {
+                                emit(t, &mut handler)?;
+                            }
+                            pending.clear();
+                            q_marks.clear();
+                        }
+                        emit(&tok, &mut handler)?;
+                    },
+                }
+            },
+            LC_NAME => {
+                operand!(i);
+                i = skip_name_raw(data, i).max(i + 1);
+            },
+            LC_PAREN => match skip_literal_string_raw(data, i) {
+                Some(end) => {
+                    operand!(i);
+                    i = end;
+                },
+                None => i += 1,
+            },
+            LC_ANGLE => {
+                let end = if data.get(i + 1) == Some(&b'<') {
+                    skip_dict_raw(data, i)
+                } else {
+                    skip_hex_string_raw(data, i)
+                };
+                match end {
+                    Some(end) => {
+                        operand!(i);
+                        i = end;
+                    },
+                    None => i += 1,
+                }
+            },
+            LC_BRACKET => match skip_array_raw(data, i) {
+                Some(end) => {
+                    operand!(i);
+                    i = end;
+                },
+                None => i += 1,
+            },
+            LC_COMMENT => {
+                while i < len && data[i] != b'\n' && data[i] != b'\r' {
+                    i += 1;
+                }
+            },
+            _ => i += 1,
+        }
+    }
+    Ok(())
+}
