+// ── Hand-rolled matchers ───────────────────────────────────────────────────
+//
+// The CMap line grammar used to be matched with `regex`. Compiling those
+// patterns cost more than parsing the CMap itself in a process that reads a
+// handful of fonts, so the same leftmost matches are found by scanning. The
+// equivalence is pinned against the original patterns in the tests below.
+
+/// Offset of the first non-whitespace character at or after `pos`.
+fn skip_cmap_ws(s: &str, pos: usize) -> usize {
+    let rest = &s[pos..];
+    pos + (rest.len() - rest.trim_start().len())
+}
+
+/// Match `K` consecutive `<…>` groups separated by optional whitespace and
+/// anchored at byte `at`. Returns the group contents and the offset just past
+/// the last `>`.
+fn angle_groups_at<const K: usize>(s: &str, at: usize) -> Option<([&str; K], usize)> {
+    let mut out = [""; K];
+    let mut pos = at;
+    for (g, slot) in out.iter_mut().enumerate() {
+        if g > 0 {
+            pos = skip_cmap_ws(s, pos);
+        }
+        if s.as_bytes().get(pos) != Some(&b'<') {
+            return None;
+        }
+        let close = pos + 1 + s[pos + 1..].find('>')?;
+        *slot = &s[pos + 1..close];
+        pos = close + 1;
+    }
+    Some((out, pos))
+}
+
+/// Successive non-overlapping leftmost matches of `K` `<…>` groups, i.e.
+/// `captures_iter` over `<([^>]*)>(\s*<([^>]*)>){K-1}`.
+struct AngleGroups<'a, const K: usize> {
+    s: &'a str,
+    pos: usize,
+}
+
+impl<'a, const K: usize> AngleGroups<'a, K> {
+    fn new(s: &'a str) -> Self {
+        Self { s, pos: 0 }
+    }
+}
+
+impl<'a, const K: usize> Iterator for AngleGroups<'a, K> {
+    type Item = [&'a str; K];
+
+    fn next(&mut self) -> Option<Self::Item> {
+        while let Some(off) = self.s[self.pos..].find('<') {
+            let at = self.pos + off;
+            if let Some((groups, end)) = angle_groups_at::<K>(self.s, at) {
+                self.pos = end;
+                return Some(groups);
+            }
+            self.pos = at + 1;
+        }
+        self.pos = self.s.len();
+        None
+    }
+}
+
+/// Leftmost `<lo> <hi> [<d1> <d2> …]`: the two bounds and the array body.
+fn find_bfrange_array(s: &str) -> Option<(&str, &str, &str)> {
+    fn at(s: &str, start: usize) -> Option<(&str, &str, &str)> {
+        let ([lo, hi], end) = angle_groups_at::<2>(s, start)?;
+        let bytes = s.as_bytes();
+        let open = skip_cmap_ws(s, end);
+        if bytes.get(open) != Some(&b'[') {
+            return None;
+        }
+        let body = open + 1;
+        let mut pos = body;
+        let mut entries = 0usize;
+        loop {
+            let p = skip_cmap_ws(s, pos);
+            match bytes.get(p) {
+                Some(b'<') => {
+                    let close = p + 1 + s[p + 1..].find('>')?;
+                    if close == p + 1 {
+                        return None; // `<>` is not an entry
+                    }
+                    pos = close + 1;
+                    entries += 1;
+                },
+                Some(b']') if entries > 0 => return Some((lo, hi, &s[body..p])),
+                _ => return None,
+            }
+        }
+    }
+    let mut from = 0;
+    while let Some(off) = s[from..].find('<') {
+        let start = from + off;
+        if let Some(found) = at(s, start) {
+            return Some(found);
+        }
+        from = start + 1;
+    }
+    None
+}
+
+/// The digits of the leftmost `/WMode <digits> def`.
+fn find_wmode_value(s: &str) -> Option<&str> {
+    let mut from = 0;
+    while let Some(off) = s[from..].find("/WMode") {
+        let at = from + off;
+        let after = at + "/WMode".len();
+        let digits = skip_cmap_ws(s, after);
+        if digits > after {
+            let end = digits
+                + s[digits..]
+                    .bytes()
+                    .take_while(u8::is_ascii_digit)
+                    .count();
+            if end > digits {
+                let def = skip_cmap_ws(s, end);
+                if def > end && s[def..].starts_with("def") {
+                    return Some(&s[digits..end]);
+                }
+            }
+        }
+        from = at + 1;
+    }
+    None
+}
