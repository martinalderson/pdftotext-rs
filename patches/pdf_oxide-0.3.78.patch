+#[cfg(test)]
+mod hand_matcher_tests {
+    use super::*;
+    use regex::Regex;
+
+    /// Deterministic strings over the characters the grammar cares about.
+    fn samples() -> Vec<String> {
+        let alphabet: Vec<char> = "<<<>>>[] \t\n01aF%/WModedef\u{a0}x".chars().collect();
+        let mut out: Vec<String> = [
+            "<0041> <0041>",
+            "<01> <0041> <02> <0042>",
+            "<005F> <0061> [<00660066> <00660069> <00660066006C>]",
+            "<x> <1> <2> [<a>]",
+            "<a <b> <c>",
+            "<0020> <007E> <0020>",
+            "<00><FF>[<>]",
+            "<00> <FF> [ <41> ]",
+            "<00> <FF> []",
+            "/WMode 1 def",
+            "/WMode  12\tdef /WMode 0 def",
+            "/WMode1 def /WMode 1def /WMode 0 def",
+            "",
+        ]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+        let mut state = 0x2545F4914F6CDD1Du64;
+        for _ in 0..20000 {
+            let mut s = String::new();
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            let len = (state % 40) as usize;
+            for _ in 0..len {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                s.push(alphabet[(state % alphabet.len() as u64) as usize]);
+            }
+            out.push(s);
+        }
+        out
+    }
+
+    #[test]
+    fn angle_groups_match_regex() {
+        let pair = Regex::new(r"<([^>]*)>\s*<([^>]*)>").unwrap();
+        let triple = Regex::new(r"<([^>]*)>\s*<([^>]*)>\s*<([^>]*)>").unwrap();
+        let single = Regex::new(r"<([^>]*)>").unwrap();
+        for s in samples() {
+            let want: Vec<Vec<String>> = pair
+                .captures_iter(&s)
+                .map(|c| vec![c[1].to_string(), c[2].to_string()])
+                .collect();
+            let got: Vec<Vec<String>> = AngleGroups::<2>::new(&s)
+                .map(|g| g.iter().map(|x| x.to_string()).collect())
+                .collect();
+            assert_eq!(got, want, "pair on {s:?}");
+
+            let want: Vec<Vec<String>> = single
+                .captures_iter(&s)
+                .map(|c| vec![c[1].to_string()])
+                .collect();
+            let got: Vec<Vec<String>> = AngleGroups::<1>::new(&s)
+                .map(|g| g.iter().map(|x| x.to_string()).collect())
+                .collect();
+            assert_eq!(got, want, "single on {s:?}");
+
+            let want = triple
+                .captures(&s)
+                .map(|c| vec![c[1].to_string(), c[2].to_string(), c[3].to_string()]);
+            let got = AngleGroups::<3>::new(&s)
+                .next()
+                .map(|g| g.iter().map(|x| x.to_string()).collect::<Vec<_>>());
+            assert_eq!(got, want, "triple on {s:?}");
+        }
+    }
+
+    #[test]
+    fn bfrange_array_matches_regex() {
+        let re = Regex::new(r"<([^>]*)>\s*<([^>]*)>\s*\[((?:\s*<[^>]+>\s*)+)\]").unwrap();
+        for s in samples() {
+            let want = re
+                .captures(&s)
+                .map(|c| (c[1].to_string(), c[2].to_string(), c[3].to_string()));
+            let got = find_bfrange_array(&s)
+                .map(|(a, b, c)| (a.to_string(), b.to_string(), c.to_string()));
+            assert_eq!(got, want, "array on {s:?}");
+        }
+    }
+
+    #[test]
+    fn wmode_matches_regex() {
+        let re = Regex::new(r"/WMode\s+([0-9]+)\s+def").unwrap();
+        for s in samples() {
+            let want = re.captures(&s).map(|c| c[1].to_string());
+            let got = find_wmode_value(&s).map(|x| x.to_string());
+            assert_eq!(got, want, "wmode on {s:?}");
+        }
+    }
+}
